    echo -e "${CYAN}🔄 Updating Astro Server toolkit...${NC}"
    
    if [ -d "$SCRIPT_DIR/.git" ]; then
        echo -e "${BLUE}📥 Pulling latest changes...${NC}"
        cd "$SCRIPT_DIR"
        git pull --ff-only origin main
        echo -e "${GREEN}✅ Update complete!${NC}"
